@model WebCoreXcatsIpad.Models.LoginModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/WebCoreXcatsIpad.styles.css" asp-append-version="true" /> *@
    <style type="text/css">
            body {
                background: url('/Imagenes/fondo.jpg');
            }

            table {
                font-family: Tahoma;
                font-size: small;
                border-collapse: collapse;
                border: 1px solid #cfcfcf;
                border-radius: 8px;
                overflow: hidden;
                box-shadow: 0 4px 10px rgba(0,0,0,0.08);
                background-color: rgba(255,255,255,0.9);
            }

            th, td {
                border: none; /* Elimina los bordes internos */
                padding: 8px 12px;
                /*border-bottom: 1px solid #e9e9e9;*/
            }

            table tr:hover td {
                background-color: #f7fbff;
            }

            th {
                background-color: #212529; /* bootstrap primary */
                color: #fff;
                font-weight: 600;
                border-bottom: 2px solid #0b5ed7;
                text-align: center;
            }

            .label {
                font-family: Tahoma;
                font-size: small;
            }

            .textbox {
                font-family: Tahoma;
                font-size: small;
            }

            .classbutton {
                border: 1px solid black;
                font-family: Tahoma;
                font-size: small;
            }
    </style>
</head>
<body>
    <div>
        <br />
        <br />
        <br />
        <div class="row">
            <div class="col-12">

                <form id="formularioPrincipal" asp-action="Login" asp-controller="Seguridad" method="POST">
                    <table align="center">
                        <tbody>
                            <tr>
                                <th colspan="4" style="text-align:center">
                                    <b>Autenticación develop merge que viene de persona 01</b>
                                </th>
                            </tr>
                            <tr>
                                <td rowspan="4" class="style14">
                                    <img id="imgMSI" src="~/Imagenes/msi.png" style="height:150px;width:150px;border-width:0px;">
                                </td>
                                <td colspan="3" style="color:#E7F0FE">.</td>
                            </tr>
                            <tr>
                                <td>
                                    <span id="lblNombre" class="label" style="display:inline-block;width:100px;">Usuario:</span>
                                </td>
                                <td colspan="2">
                                    @Html.TextBoxFor(m => m.usuario, new { @class = "form-control-sm", @style = "width:180px;text-transform:lowercase", type = "text" })
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span id="Label1" class="label" style="display:inline-block;width:100px;">Contraseña:</span>
                                </td>
                                <td colspan="2">
                                    @Html.TextBoxFor(m => m.contraseña, new { @class = "form-control-sm", @style = "width:180px;text-transform:lowercase", type = "password" })
                                </td>
                            </tr>
                            <tr>
                                <td>
                                </td>
                                <td colspan="2">
                                    <div align="center">
                                        <button type="button" class="btn btn-light classbutton" onclick="Login()">Autenticar</button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4">
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4" style="text-align:center; color:Black;">
                                    Favor de ingresar <b>USUARIO</b> y <b>CONTRASEÑA</b> para continuar.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </form>
            </div>
        </div>
        <br />
        <br />
        <br />
        <br />
        <br />
        <br />
    </div>
    <div class="modal fade modal-sm" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" id="modalError">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">XCATS</h1>
                    @*<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>*@
                </div>
                <div class="modal-body alert alert-danger">
                    <p class="label" id="mensajeError"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="label btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
     <div class="modal fade" id="loadingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 bg-transparent shadow-none text-center">
                <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-light mt-2">Please wait...</p>
            </div>
        </div>
    </div>
    @* <script src="~/lib/jquery/dist/jquery-4.0.0.min.js"></script> *@
    <script src="~/lib/jquery/dist/jquery-3.7.1.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="@Url.Content("~/Scripts/mtGenericos.js")"></script>
</body>
</html>
<script>
    async function Login() {
        debugger;
        if(InicioPeticion()){
            const form = document.getElementById('formularioPrincipal');
            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                method: form.method,
                body: formData
            });
            var result = await response;
            if (result.status == 1) {
                window.location.href = "@Url.Content("~/Home")";
            } else {
                $('#mensajeError').text('Favor de validar su usuario o contraseña');
                $('#modalError').modal('show');
            }
        }
    }
    function InicioPeticion() {
    //debugger
        var usuario = $("#usuario").val();
        var contrasena = $("#contrase_a").val();

        if (usuario.trim().length == 0) {
            $('#mensajeError').text('El Usuario es un dato requerido');
            $('#modalError').modal('show');
            return false;
        }
        if (contrasena.trim().length == 0) {
            $('#mensajeError').text('La contraseña es un dato requerido');
            $('#modalError').modal('show');
            modalSpinner.hide();
            return false;
            modalSpinner.show();
        }
    }
    function ErrorPeticion() {
        modalSpinner.show();
        Alert("Error en la petición")
    }
    function PeticionSuccess(data) {
    //debugger
        if (data.status == 1) {
            window.location.href = "@Url.Content("~/Home")";
        } else {
            $('#mensajeError').text('Favor de validar su usuario o contraseña');
            $('#modalError').modal('show');
        }
    }
    function PeticionCompleta() {
        modalSpinner.hide();
    }
</script>


